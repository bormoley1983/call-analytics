# Paths
PROJECT_ROOT=/work

# Source selection
#DAYS=2024/10/11,2024/10/14,2024/10/16,2024/10/17,2024/10/18
PROCESS_LIMIT=30

# Whisper
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL=large-v3-turbo
WHISPER_BEAM_SIZE=5

# STT selection and provider settings
# In compose, each service can override STT_ENGINE explicitly:
# - stt-whisper: STT_ENGINE=faster-whisper
# - stt-canary:  STT_ENGINE=canary
STT_ENGINE=faster-whisper
CANARY_MODEL_ID=nvidia/canary-1b-v2
CANARY_MODEL_REVISION=unknown
CANARY_DEVICE=cuda
CANARY_COMPUTE_TYPE=float16
CANARY_BATCH_SIZE=1
CANARY_BEAM_SIZE=1

MIN_BYTES=20000
MIN_SECONDS=1.0

# Ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=1m
OLLAMA_THINK=0
# 1 = sequential (Ollama/single GPU). >1 = concurrent (vLLM, llama.cpp with parallel slots)
ANALYSIS_WORKERS=1

# Control
FORCE_REANALYZE=0
FORCE_TRANSLATE_UK=1
MAX_CHARS_ANALYZE=9000

# Logging
# LOG_LEVEL: Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# LOG_FORMAT: Console output format — "text" for human-readable or "json" for structured
LOG_FORMAT=text
# LOG_FILE: Path to rotating JSON log file (failsafe — always enabled). Default: logs/app.json
# LOG_FILE=/var/log/call-analytics/app.json
# LOG_MAX_BYTES: Max bytes per log file before rotation (default: 10 MiB)
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT: Number of rotated log files to keep (default: 5)
# LOG_BACKUP_COUNT=5
# Elasticsearch integration (optional — sends ERROR+ logs remotely)
# LOG_ES_URL=https://es-host:9200
# LOG_ES_INDEX=call-analytics
# LOG_ES_LEVEL=ERROR
# LOG_ES_USERNAME=
# LOG_ES_PASSWORD=

# Postgres
#POSTGRES_DSN=postgresql://user:pass@host/db

# PBX sync
# PBX_HOST=192.168.10.202
# PBX_PORT=22
# PBX_USER=monitor_reader
# PBX_AUTH_MODE=key
# PBX_PASSWORD=
# PBX_KEY_PATH=/work/config/ssh/pbx_ed25519
# PBX_KNOWN_HOSTS_PATH=/work/config/ssh/known_hosts
# PBX_REMOTE_DIR=/var/spool/asterisk/monitor
